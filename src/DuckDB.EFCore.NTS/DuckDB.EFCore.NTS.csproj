<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageVersion>1.0.5</PackageVersion>
        <FileVersion>1.0.5</FileVersion>
        <Version>1.0.5</Version>
        <Authors>Denis Ivanov</Authors>
        <Description>NetTopologySuite (spatial) support for the DuckDB provider for Entity Framework Core.</Description>
        <PackageTags>DuckDB; Entity Framework Core; EF Core; NetTopologySuite; Spatial; GIS</PackageTags>
        <PackageIcon>DuckDB_icon-lightmode.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/denis-ivanov/DuckDB.EFCore</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>
            Reelease notes: https://github.com/denis-ivanov/DuckDB.EFCore/releases/tag/v1.0.5
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
      <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DuckDB.EFCore\DuckDB.EFCore.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\DuckDB_icon-lightmode.png" Pack="true" PackagePath="" />
      <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
      <None Include="..\..\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
